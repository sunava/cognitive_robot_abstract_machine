  <link name="driver">
    <visual>
      <geometry>
        <mesh filename="assets/driver.glb" />
      </geometry>
    </visual>
    <collision name="flat_blade">
      <origin xyz="0 0 0.013" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.004 0.026" />
      </geometry>
    </collision>
    <collision name="shaft">
      <origin xyz="0 0 0.076" />
      <geometry>
        <cylinder radius="0.0045" length="0.1" />
      </geometry>
    </collision>
    <collision name="handle">
      <origin xyz="0 0 0.178" />
      <geometry>
        <cylinder radius="0.024" length="0.104" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.155" />
      <mass value="0.28" />
      <inertia ixx="0.0012880933333333335" iyy="0.0012880933333333335" izz="0.00010752000000000001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="driver_tip" />
  <joint name="driver_tip_joint" type="fixed">
    <parent link="driver" />
    <child link="driver_tip" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="driver_grasp" />
  <joint name="driver_grasp_joint" type="fixed">
    <parent link="driver" />
    <child link="driver_grasp" />
    <origin xyz="0 0 0.165" rpy="0 0 0" />
  </joint>
</robot>