<?xml version="1.0"?>
<!--
  A storage warehouse, converted from a Wavefront model by
  generate_warehouse_model.py. The building and its stored goods are visual
  only; collision geometry is limited to the two surfaces the robot works on,
  the target shelf and the loaded pallet, so motion planning interacts with
  exactly those and nothing else. The floor surface is at z = 0.
-->
<robot name="storage_warehouse">

  <material name="besi_lamp">
    <color rgba="0.9063 0.9063 0.9063 1.0"/>
  </material>
  <material name="hitam_dop">
    <color rgba="0.1245 0.121 0.1155 1.0"/>
  </material>
  <material name="putih_dop">
    <color rgba="0.9063 0.9063 0.9063 1.0"/>
  </material>
  <material name="besi_biru">
    <color rgba="0.0329 0.0105 0.1444 1.0"/>
  </material>
  <material name="besi_hijau">
    <color rgba="0.326 0.4063 0.2166 1.0"/>
  </material>
  <material name="besi_kuning">
    <color rgba="0.9063 0.7297 0.4362 1.0"/>
  </material>
  <material name="besi_lis">
    <color rgba="0.6063 0.6063 0.6063 1.0"/>
  </material>
  <material name="besi_merah">
    <color rgba="0.3563 0.0644 0.0772 1.0"/>
  </material>
  <material name="besi_putih">
    <color rgba="0.8563 0.8563 0.8563 1.0"/>
  </material>
  <material name="cat_kuning">
    <color rgba="0.8063 0.7213 0.1861 1.0"/>
  </material>
  <material name="gerbang">
    <color rgba="0.8238 0.9017 0.9063 1.0"/>
  </material>
  <material name="kaca">
    <color rgba="0.9063 0.9063 0.9063 1.0"/>
  </material>
  <material name="kain_biru">
    <color rgba="0.0485 0.0822 0.1563 1.0"/>
  </material>
  <material name="kardus">
    <color rgba="0.5709 0.4497 0.3932 1.0"/>
  </material>
  <material name="kayu">
    <color rgba="0.5563 0.4239 0.3391 1.0"/>
  </material>
  <material name="kayu_2">
    <color rgba="0.2806 0.2193 0.1856 1.0"/>
  </material>
  <material name="kayu_box">
    <color rgba="0.4563 0.2839 0.1711 1.0"/>
  </material>
  <material name="krum_1">
    <color rgba="0.9063 0.9063 0.9063 1.0"/>
  </material>
  <material name="krum_1_001">
    <color rgba="0.9063 0.9063 0.9063 1.0"/>
  </material>
  <material name="lantai">
    <color rgba="0.1563 0.1563 0.1563 1.0"/>
  </material>
  <material name="plastik_abu">
    <color rgba="0.2563 0.2563 0.2563 1.0"/>
  </material>
  <material name="plastik_biru">
    <color rgba="0.0489 0.0278 0.2062 1.0"/>
