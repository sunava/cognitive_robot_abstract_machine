    <color rgba="0.96 0.96 0.94 1.0"/>
  </material>
  <material name="helmet_yellow">
    <color rgba="0.98 0.80 0.05 1.0"/>
  </material>

  <link name="hall_root"/>

  <!-- concrete floor: a textured quad over the slab, surface at z = 0 -->
  <link name="hall_floor">
    <visual>
      <origin xyz="-1 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <box size="24.2 15.4 0.06"/>
      </geometry>
      <material name="epoxy_floor_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/floor.obj"/>
      </geometry>
    </visual>
  </link>
  <joint name="hall_floor_joint" type="fixed">
    <parent link="hall_root"/>
    <child link="hall_floor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

