<?xml version="1.0"?>
<!--
  A wind-turbine nacelle assembly hall, modeled on real production lines: a row of
  three nacelle housings on turquoise assembly stands (the middle one already carries
  its rotor hub and spinner), a work platform at the active station, tower sections,
  rotor blades in storage racks, a gantry crane, a pallet rack in the logistics
  corner, technicians, safety fencing and marked floor lanes.

  The hall is deliberately open: no perimeter walls or roof trusses, only the columns
  of the hall skeleton, so the camera can orbit freely. Only the two part tables carry
  collision geometry, so the robot's motion planning interacts with exactly the
  surfaces it picks from and places onto; everything else is visual dressing. All
  poses are in hall world coordinates, the floor surface is at z = 0.

  The blade, nacelle-shell and spinner meshes are generated by generate_hall_meshes.py.
-->
<robot name="wind_turbine_hall">

  <material name="epoxy_floor_grey">
    <color rgba="0.80 0.81 0.82 1.0"/>
  </material>
  <material name="floor_joint_grey">
    <color rgba="0.68 0.70 0.72 1.0"/>
  </material>
  <material name="structure_steel_blue">
    <color rgba="0.20 0.32 0.40 1.0"/>
  </material>
  <material name="turbine_white">
    <color rgba="0.93 0.95 0.96 1.0"/>
  </material>
  <material name="stand_turquoise">
    <color rgba="0.05 0.43 0.47 1.0"/>
  </material>
  <material name="accent_teal">
    <color rgba="0.0 0.55 0.58 1.0"/>
  </material>
  <material name="steel_grey">
    <color rgba="0.62 0.66 0.70 1.0"/>
  </material>
  <material name="galvanized_grey">
    <color rgba="0.72 0.75 0.77 1.0"/>
  </material>
  <material name="dark_steel">
    <color rgba="0.14 0.16 0.19 1.0"/>
  </material>
  <material name="crane_yellow">
    <color rgba="0.91 0.66 0.05 1.0"/>
  </material>
  <material name="marking_yellow">
    <color rgba="0.95 0.76 0.06 1.0"/>
  </material>
  <material name="marking_black">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>
  <material name="walkway_green">
    <color rgba="0.16 0.55 0.34 1.0"/>
  </material>
  <material name="marking_white">
    <color rgba="0.92 0.93 0.94 1.0"/>
  </material>
  <material name="rack_steel_blue">
    <color rgba="0.16 0.32 0.55 1.0"/>
  </material>
  <material name="rack_beam_orange">
    <color rgba="0.86 0.44 0.10 1.0"/>
  </material>
  <material name="pallet_wood">
    <color rgba="0.73 0.54 0.29 1.0"/>
  </material>
  <material name="crate_teal">
    <color rgba="0.10 0.45 0.50 1.0"/>
  </material>
  <material name="toolbox_red">
    <color rgba="0.72 0.12 0.10 1.0"/>
  </material>
  <material name="high_visibility_orange">
    <color rgba="0.95 0.36 0.03 1.0"/>
  </material>
  <material name="reflective_silver">
    <color rgba="0.87 0.89 0.90 1.0"/>
  </material>
  <material name="work_trouser_navy">
    <color rgba="0.16 0.20 0.25 1.0"/>
  </material>
  <material name="boot_black">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>
  <material name="skin">
    <color rgba="0.85 0.63 0.46 1.0"/>
  </material>
