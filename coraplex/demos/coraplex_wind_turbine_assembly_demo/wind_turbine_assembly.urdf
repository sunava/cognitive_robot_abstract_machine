<?xml version="1.0"?>
<!--
  Wind-turbine assembly station dressing for the AWS small warehouse.

  Purely visual scenery (no collision geometry, so motion planning is unaffected):
  a rotor blade on trestles, a nacelle housing on assembly stands, a rotor hub,
  a workbench, two technicians in high-visibility clothing and a marked assembly
  floor zone. All poses are expressed in warehouse world coordinates; the model
  is merged into the warehouse at the identity pose.

  The blade mesh is generated by generate_turbine_blade_mesh.py.
-->
<robot name="wind_turbine_assembly">

  <material name="turbine_white">
    <color rgba="0.93 0.95 0.96 1.0"/>
  </material>
  <material name="turbine_teal">
    <color rgba="0.0 0.6 0.62 1.0"/>
  </material>
  <material name="steel_grey">
    <color rgba="0.62 0.66 0.70 1.0"/>
  </material>
  <material name="dark_steel">
    <color rgba="0.16 0.18 0.21 1.0"/>
  </material>
  <material name="trestle_blue">
    <color rgba="0.16 0.32 0.55 1.0"/>
  </material>
  <material name="high_visibility_orange">
    <color rgba="0.95 0.36 0.03 1.0"/>
  </material>
  <material name="reflective_silver">
    <color rgba="0.87 0.89 0.90 1.0"/>
  </material>
  <material name="work_trouser_navy">
    <color rgba="0.16 0.20 0.25 1.0"/>
  </material>
  <material name="boot_black">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>
  <material name="skin">
    <color rgba="0.85 0.63 0.46 1.0"/>
  </material>
  <material name="helmet_white">
    <color rgba="0.96 0.96 0.94 1.0"/>
  </material>
  <material name="helmet_yellow">
    <color rgba="0.98 0.80 0.05 1.0"/>
  </material>
  <material name="marking_yellow">
    <color rgba="0.95 0.76 0.06 1.0"/>
  </material>
  <material name="toolbox_red">
    <color rgba="0.72 0.12 0.10 1.0"/>
  </material>
  <material name="bench_top_grey">
    <color rgba="0.35 0.38 0.42 1.0"/>
  </material>

  <link name="assembly_area_root"/>

  <!-- rotor blade resting on two trestles, root to the south -->
  <link name="turbine_blade">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/turbine_blade.stl"/>
      </geometry>
      <material name="turbine_white"/>
    </visual>
  </link>
  <joint name="turbine_blade_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="turbine_blade"/>
    <origin xyz="-0.35 4.6 0.88" rpy="0 0 1.5708"/>
  </joint>

  <link name="blade_trestles">
    <!-- south trestle: beam plus two splayed leg panels -->
    <visual>
      <origin xyz="-0.35 5.5 0.74" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.12 0.08"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.35 5.36 0.36" rpy="0.32 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.74"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.35 5.64 0.36" rpy="-0.32 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.74"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
    <!-- north trestle, taller because the blade thins towards its tip -->
    <visual>
      <origin xyz="-0.35 7.5 0.79" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.12 0.08"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.35 7.36 0.385" rpy="0.30 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.79"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.35 7.64 0.385" rpy="-0.30 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.79"/>
      </geometry>
      <material name="trestle_blue"/>
    </visual>
  </link>
  <joint name="blade_trestles_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="blade_trestles"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- nacelle housing on two assembly stands -->
  <link name="nacelle_housing">
    <visual>
      <origin xyz="0.0 5.6 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.9 0.25"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="1.4 5.6 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.9 0.25"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="0.7 5.6 0.78" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 1.05"/>
      </geometry>
      <material name="turbine_white"/>
    </visual>
    <!-- teal accent band -->
    <visual>
      <origin xyz="0.7 5.6 1.02" rpy="0 0 0"/>
      <geometry>
        <box size="2.02 1.02 0.16"/>
      </geometry>
      <material name="turbine_teal"/>
    </visual>
    <!-- rotor flange on the west face -->
    <visual>
      <origin xyz="-0.34 5.6 0.78" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.40" length="0.08"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.39 5.6 0.78" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.24" length="0.06"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <!-- cooling vents on the east face -->
    <visual>
      <origin xyz="1.72 5.6 0.82" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.8 0.7"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
  </link>
  <joint name="nacelle_housing_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="nacelle_housing"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- rotor hub waiting south of the nacelle -->
  <link name="rotor_hub">
    <visual>
      <origin xyz="0.7 4.55 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.55 0.55 0.12"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="0.7 4.55 0.35" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.30" length="0.46"/>
      </geometry>
      <material name="turbine_white"/>
    </visual>
    <visual>
      <origin xyz="0.7 4.55 0.58" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.30"/>
      </geometry>
      <material name="turbine_white"/>
    </visual>
    <visual>
      <origin xyz="0.7 4.55 0.19" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.305" length="0.07"/>
      </geometry>
      <material name="turbine_teal"/>
    </visual>
  </link>
  <joint name="rotor_hub_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="rotor_hub"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- workbench between the delivery point and the nacelle -->
  <link name="workbench">
    <visual>
      <origin xyz="1.1 7.2 0.9" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 1.6 0.06"/>
      </geometry>
      <material name="bench_top_grey"/>
    </visual>
    <visual>
      <origin xyz="0.82 6.48 0.435" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.87"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="1.38 6.48 0.435" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.87"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="0.82 7.92 0.435" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.87"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <visual>
      <origin xyz="1.38 7.92 0.435" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.87"/>
      </geometry>
      <material name="dark_steel"/>
    </visual>
    <!-- toolbox and a spare flange on the bench top -->
    <visual>
      <origin xyz="1.05 6.75 1.02" rpy="0 0 0.2"/>
      <geometry>
        <box size="0.25 0.38 0.18"/>
      </geometry>
      <material name="toolbox_red"/>
    </visual>
    <visual>
      <origin xyz="1.15 7.55 0.955" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.14" length="0.05"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
  </link>
  <joint name="workbench_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="workbench"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- technician awaiting deliveries at the workbench, facing the drop-off point -->
  <link name="assembly_technician_one">
    <visual>
      <origin xyz="0 0.09 0.41" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.82"/>
      </geometry>
      <material name="work_trouser_navy"/>
    </visual>
    <visual>
      <origin xyz="0 -0.09 0.41" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.82"/>
      </geometry>
      <material name="work_trouser_navy"/>
    </visual>
    <visual>
      <origin xyz="0.05 0.09 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.11 0.10"/>
      </geometry>
      <material name="boot_black"/>
    </visual>
    <visual>
      <origin xyz="0.05 -0.09 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.11 0.10"/>
      </geometry>
      <material name="boot_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 1.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.40 0.54"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.98" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.41 0.055"/>
      </geometry>
      <material name="reflective_silver"/>
    </visual>
    <visual>
      <origin xyz="0 0 1.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.41 0.055"/>
      </geometry>
      <material name="reflective_silver"/>
    </visual>
    <visual>
      <origin xyz="0 0.265 1.03" rpy="-0.16 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.60"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0 -0.265 1.03" rpy="0.16 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.60"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0.313 0.72" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.052"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0 -0.313 0.72" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.052"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 1.50" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 1.545" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.115"/>
      </geometry>
      <material name="helmet_white"/>
    </visual>
    <visual>
      <origin xyz="0.05 0 1.50" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.025"/>
      </geometry>
      <material name="helmet_white"/>
    </visual>
  </link>
  <joint name="assembly_technician_one_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="assembly_technician_one"/>
    <origin xyz="1.75 7.0 0.03" rpy="0 0 0.68"/>
  </joint>

  <!-- technician working on the nacelle, facing it from the north -->
  <link name="assembly_technician_two">
    <visual>
      <origin xyz="0 0.09 0.41" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.82"/>
      </geometry>
      <material name="work_trouser_navy"/>
    </visual>
    <visual>
      <origin xyz="0 -0.09 0.41" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.82"/>
      </geometry>
      <material name="work_trouser_navy"/>
    </visual>
    <visual>
      <origin xyz="0.05 0.09 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.11 0.10"/>
      </geometry>
      <material name="boot_black"/>
    </visual>
    <visual>
      <origin xyz="0.05 -0.09 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.11 0.10"/>
      </geometry>
      <material name="boot_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 1.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.40 0.54"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.98" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.41 0.055"/>
      </geometry>
      <material name="reflective_silver"/>
    </visual>
    <visual>
      <origin xyz="0 0 1.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.27 0.41 0.055"/>
      </geometry>
      <material name="reflective_silver"/>
    </visual>
    <!-- arms reaching forward towards the nacelle -->
    <visual>
      <origin xyz="0.22 0.24 1.22" rpy="0 1.15 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.60"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0.22 -0.24 1.22" rpy="0 1.15 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.60"/>
      </geometry>
      <material name="high_visibility_orange"/>
    </visual>
    <visual>
      <origin xyz="0.47 0.24 1.10" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.052"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.47 -0.24 1.10" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.052"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 1.50" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 1.545" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.115"/>
      </geometry>
      <material name="helmet_yellow"/>
    </visual>
    <visual>
      <origin xyz="0.05 0 1.50" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.025"/>
      </geometry>
      <material name="helmet_yellow"/>
    </visual>
  </link>
  <joint name="assembly_technician_two_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="assembly_technician_two"/>
    <origin xyz="0.5 6.55 0.03" rpy="0 0 -1.5708"/>
  </joint>

  <!-- yellow floor marking framing the assembly zone; the west and north strips
       stop short of the warehouse pallets and shelves already standing there -->
  <link name="assembly_zone_marking">
    <visual>
      <origin xyz="-0.72 7.45 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 2.0 0.006"/>
      </geometry>
      <material name="marking_yellow"/>
    </visual>
    <visual>
      <origin xyz="1.85 6.5 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 4.7 0.006"/>
      </geometry>
      <material name="marking_yellow"/>
    </visual>
    <visual>
      <origin xyz="0.725 4.15 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="2.25 0.08 0.006"/>
      </geometry>
      <material name="marking_yellow"/>
    </visual>
    <visual>
      <origin xyz="0.875 8.85 0.003" rpy="0 0 0"/>
      <geometry>
        <box size="1.95 0.08 0.006"/>
      </geometry>
      <material name="marking_yellow"/>
    </visual>
  </link>
  <joint name="assembly_zone_marking_joint" type="fixed">
    <parent link="assembly_area_root"/>
    <child link="assembly_zone_marking"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

</robot>
