#usda 1.0
(
    doc = "A Y-up stage in centimetres: one triangle 100 units above the floor."
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Marker"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 100, 0), (10, 100, 0), (0, 100, -10)]
        color3f[] primvars:displayColor = [(0.1, 0.8, 0.2)]
    }
}
