#usda 1.0
(
    doc = """A rover marked with Isaac Sim's robot schema whose gripper the stage puts beside the marked prim, as an older twin does: the RoverGripper holds a Palm on a Mount joint to the rover's Chassis and a Finger on a slide from the Palm, all outside /World/Robots/Rover. The rover also carries a Tote on a Carry joint that lives inside the rover, as a grasp joint does in a twin whose robot layer holds its own joints."""
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Floor"
    {
        double size = 1
        double3 xformOp:scale = (6, 6, 0.02)
        double3 xformOp:translate = (0, 0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Robots"
    {
        def Xform "Rover" (
            prepend apiSchemas = ["IsaacRobotAPI"]
        )
        {
            def Xform "Chassis" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"]
            )
            {
                double3 xformOp:translate = (1, 0, 0.2)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Body"
                {
                    double size = 0.4
                }
            }

            def Scope "Joints"
            {
                def PhysicsFixedJoint "Carry"
                {
                    rel physics:body0 = </World/Robots/Rover/Chassis>
                    rel physics:body1 = </World/Tote>
                    point3f physics:localPos0 = (0, 0, 0.3)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }

        def Xform "RoverGripper"
        {
            def Xform "Palm" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                double3 xformOp:translate = (1.3, 0, 0.4)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Plate"
                {
                    double size = 0.1
                }
            }

            def Xform "Finger" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                double3 xformOp:translate = (1.4, 0, 0.4)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Pad"
                {
                    double size = 0.04
                }
            }

            def PhysicsFixedJoint "Mount"
            {
                rel physics:body0 = </World/Robots/Rover/Chassis>
                rel physics:body1 = </World/Robots/RoverGripper/Palm>
                point3f physics:localPos0 = (0.3, 0, 0.2)
                quatf physics:localRot0 = (1, 0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsPrismaticJoint "FingerSlide"
            {
                rel physics:body0 = </World/Robots/RoverGripper/Palm>
                rel physics:body1 = </World/Robots/RoverGripper/Finger>
                uniform token physics:axis = "Y"
                float physics:lowerLimit = -0.02
                float physics:upperLimit = 0.02
                point3f physics:localPos0 = (0.1, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }

    def Xform "Tote" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (1, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Crate"
        {
            double size = 0.2
        }
    }
}
