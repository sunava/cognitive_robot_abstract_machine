<?xml version="1.0"?>
<robot name="inspection_fixture">
  <link name="base" />
  <link name="lid">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004" />
    </inertial>
  </link>
  <joint name="fixture__hinge" type="revolute">
    <parent link="base" /><child link="lid" />
    <origin xyz="0 0 1" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="1.2" effort="0.5" velocity="0.5" />
  </joint>
</robot>
